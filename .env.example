# Copy this file to .env for the local scripts, and add the same values
# in Vercel under Project > Settings > Environment Variables.

# From @BotFather, e.g. 123456789:AAH...
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Meera's numeric Telegram user ID, e.g. 123456789
ALLOWED_USER_ID=your-telegram-user-id-here

# Any random string of letters, numbers, _ or - (up to 256 chars).
# Telegram sends it with every request so the function can reject fakes.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=your-random-secret-here

# Optional. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
